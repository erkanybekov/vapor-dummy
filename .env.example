# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password
DATABASE_NAME=vapor_database

# Environment
VAPOR_ENV=development

# JWT signing secret: required in production, at least 32 characters.
# Generate with: openssl rand -hex 32
# JWT_SECRET=

# Server Configuration
PORT=8080
HOST=127.0.0.1

# Video calls (WebRTC signaling)
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=coturn-static-auth-secret
# TURN_USERNAME=static-user        # alternative to TURN_SECRET for hosted TURN
# TURN_CREDENTIAL=static-password
# TURN_TTL_SECONDS=86400
# CALL_RING_TIMEOUT_SECONDS=30
# CALL_RECONNECT_GRACE_SECONDS=15
